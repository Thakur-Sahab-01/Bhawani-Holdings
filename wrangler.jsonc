{
  // Root-level config used by Cloudflare Workers Builds, which runs
  // `npx wrangler deploy --config wrangler.jsonc` from the workspace root.
  // Deploys the built website as a Worker with static assets (SPA fallback)
  // and routes POST /api/enquiries to the shared enquiry handler in worker.js.
  // The website artifact also has a Pages-style config at
  // artifacts/bhawani-holdings/wrangler.jsonc for deploys from that directory.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bhawani-holdings",
  "compatibility_date": "2026-10-26",
  "main": "worker.js",
  "assets": {
    "directory": "artifacts/bhawani-holdings/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "ENQUIRIES_DB",
      "database_name": "bhawani-holdings-enquiries",
      "database_id": "f06256a2-b09d-48af-a9de-ef6cd9590125",
      "migrations_dir": "artifacts/bhawani-holdings/migrations"
    }
  ]
}
